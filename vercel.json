{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "installCommand": "bun install",
  "framework": "vite",
  "functions": {
    "api/*.ts":          { "runtime": "@vercel/node@3" },
    "api/quotes/v2.ts":  { "runtime": "@vercel/node@3" },
    "api/fulfill/v2.ts": { "runtime": "@vercel/node@3" }
  },
  "routes": [
    { "src": "/api/rpc",        "dest": "/api/rpc" },
    { "src": "/api/health",     "dest": "/api/health" },
    { "src": "/api/quotes/v2",  "dest": "/api/quotes/v2" },
    { "src": "/api/fulfill/v2", "dest": "/api/fulfill/v2" },
    { "src": "/api/quotes",     "dest": "/api/quotes" },
    { "src": "/api/fulfill",    "dest": "/api/fulfill" },
    { "handle": "filesystem" },
    { "src": "/(.*)",           "dest": "/index.html" }
  ]
}
